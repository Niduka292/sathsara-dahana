{
  "rules": {
    "lightshow": {
      "state": {
        ".read": true,
        ".write": true
      },
      "sessions": {
        ".read": true,
        "$sessionId": {
          ".write": true
        }
      },
      "meta": {
        ".read": true,
        "audienceCount": {
          ".write": true
        }
      }
    },
    "puzzle": {
      "daily": {
        "$dateKey": {
          "$visitorId": {
            ".read": true,
            ".write": true
          }
        }
      },
      "firstWinner": {
        ".read": true,
        ".write": "!data.exists()"
      }
    }
  }
}
